# Gemini API key (from https://aistudio.google.com/apikey)
# Used for /api/analyze-chart when the client does not send X-API-Key.
# The app sends the first 3 rows of the uploaded file plus the optional prompt to Gemini.
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (for /api/generate-chart when the client does not send X-API-Key)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: port (default 3000)
# PORT=3000
